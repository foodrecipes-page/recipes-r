  "instructions": [
    "Preheat oven to 375°F (190°C).",
    "In a medium saucepan, combine coconut milk, rum, and brown sugar. Heat over medium heat, stirring occasionally, until sugar dissolves.",
    "In a separate bowl, whisk together flour and baking powder.",
    "Add dry ingredients to coconut mixture and whisk until combined.",
    "Pour mixture into a 9x9-inch baking dish.",
    "Top with crumbles.",
    "Bake for 25-30 minutes or until golden brown.",
    "Remove from oven and let cool for 10 minutes before serving."
